<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

    <title>Mildliner Color Reference</title>
    <meta property="og:title" content="Mildliner Color Reference">
    <meta name="description" content="A guide to all the Mildliner colors and sets">
    <meta property="og:description" content="A guide to all the Mildliner colors and sets">
    <meta property="og:url" content="https://mildliners.rknight.me">


    <meta property="og:image" content="https://mildliners.rknight.me/assets/img/preview.png">
    <meta name="theme-color" content="#ffb6d9"/>
    <link rel="icon" type="image/png" href="/assets/img/icons/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/assets/img/icons/favicon.svg" />
    <link rel="shortcut icon" href="/assets/img/icons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/img/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Mildliners" />
    <link rel="manifest" href="/assets/img/icons/site.webmanifest" />

    <meta name="fediverse:creator" content="@robb@social.lol">
    
    <link href="/assets/css/styles.css?v=2" type="text/css" rel="stylesheet"/>
  </head>

  <body>
    <header>
        <h1 class="marker">Mildliner Reference</h1>
        <p>A guide to all the <a href="https://www.zebrapen.com/pages/discover-mildliner">Mildliner</a> colours and sets.</p>
        <p><strong>There are currently {{ mildliners.all | length }} Mildliner colours across {{ mildliners.types | length - 1 }} pen styles available.</strong></p>
        <p>A <a href="https://rknight.me">Robb Knight</a> curio &bull; <a href="https://clickart.rknight.me">Clickart Reference</a> • <a href="https://rknight.me/blog/how-many-mildliner-colours-are-there-now/">Read the blog post</a></p>
    </header>

    <style>
        @keyframes colorCycle {
            {{ mildliners.cssSteps | safe }}
        }

        .mildliner-svg {
            color: #{{ mildliners.all[0].color }};
            animation: colorCycle 200s infinite linear;
        }

        {% for typekey in mildliners.types %}
            #radio-{{ typekey | lower }}:checked ~ #by-{{ typekey | lower }} {
                display: block;
            }

            {% for typekey2 in mildliners.types %}
                {% if typekey != typekey2 %}
                    #radio-{{ typekey | lower }}:checked ~ #by-{{ typekey2 | lower }} { display: none; }
                {% endif %}
            {% endfor %}
        {% endfor %}
    </style>
    
    <div class="mildliner-wrap" style="margin-top: 2em;">

        <input type="radio" id="radio-mildliner" name="sorting" value="radio-mildliner" checked>
        <label for="radio-mildliner">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#mildliner"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #0533cb;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>

        <input type="radio" id="radio-brush" name="sorting" value="radio-brush">
        <label for="radio-brush">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#brush"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #f53893;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>
        
        <input type="radio" id="radio-fine" name="sorting" value="radio-fine">
        <label for="radio-fine">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#fine"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #03ff00;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>
        
        <input type="radio" id="radio-mix" name="sorting" value="radio-mix">
        <label for="radio-mix">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#mix"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #ff3c00;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>

        <input type="radio" id="radio-dot" name="sorting" value="radio-dot">
        <label for="radio-dot">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#dot"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #ffdd00;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>
        
        <input type="radio" id="radio-stamp" name="sorting" value="radio-stamp">
        <label for="radio-stamp">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#stamp"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #00eeff;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>

        <input type="radio" id="radio-fragrance" name="sorting" value="radio-fragrance">
        <label for="radio-fragrance">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#fragrance"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #00eeff;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>

        <input type="radio" id="radio-colour" name="sorting" value="radio-colour">
        <label for="radio-colour">
            <div class="label-wrap">
                <svg class="icon" style=""><use xlink:href="#allcolors"></use></svg>
                <div class="menu-bg">
                    <svg class="icon" style="color: #00ffb7;">
                        <use xlink:href="#stroke"></use>
                    </svg>
                </div>
            </div>
        </label>

        {% set comma = joiner() %}

        {% for type in mildliners.data %}
            {% if type.prefix or type.name == 'Colour' %}
                <style>
                    #by-{{ type.name | lower }} .mildliner {
                        height: 85px;
                    }
                </style>
            {% endif %}

            <div id="by-{{ type.name | lower }}">

                <div class="mildliner-svg">
                    {% if type.name == 'Colour' %}
                        <svg class="icon" style=""><use xlink:href="#pen-mildliner"></use></svg>
                    {% else %}
                        <svg class="icon" style=""><use xlink:href="#pen-{{ type.name | lower }}"></use></svg>
                    {% endif %}
                </div>
                
                {% if type.name != 'Colour' %}
                    <p style="margin: 0;"><strong>{{ type.name }} has {{ type.sets | length }} set{% if type.sets | length > 1 %}s{% endif %} and {{ type.colours | length }} colours</strong></p>
                {% else %}
                    <p class="key">
                        {% for type in mildliners.types %}
                            {% if type != 'Colour' %}
                                 <svg class="icon" style=""><use xlink:href="#circle-{{ type | lower }}"></use></svg> {{ type }}&nbsp;&nbsp;
                            {% endif %}
                        {% endfor %}
                    </p>
                {% endif %}

                {% set setKeys = type.sets | objectKeys %}
                {% for set in setKeys %}
                    
                    <h1 class="marker" style="margin-top: 0.5em;">{{ set }}</h1>

                    <p class="color-peek">
                        <a href="https://colorpeek.com#{% for h in type.sets[set] %}{{ comma() }}{{ h.color }}{% endfor %}" target="_blank">
                            <svg class="icon" style=""><use xlink:href="#colorpeek"></use></svg> view on colorpeek
                        </a>
                    </p>
                    
                    {% for ml in type.sets[set] %}
                        <div class="mildliner">
                            <div class="mildliner-bg">
                                <svg class="icon" style="width: 100%;height:100%;color: #{{ ml.color }}">
                                    <use xlink:href="#stroke"></use>
                                </svg>
                            </div>
                            <div class="mildliner-info">
                                <h2 {% if ml.icon %} class="with-icon"{% endif %}>{{ ml.name }}{% if ml.icon %}<svg class="icon"><use xlink:href="#{{ ml.icon }}"></use></svg> {% endif %}</h2>
                                <p class="mildliner-color" data-color="#{{ ml.color }}">#{{ ml.color }} {% if ml.note %}({{ ml.note }}){% endif %}</p>
                                {% if ml.code and type.prefix %}<p class="mildliner-metadata">{{ type.prefix }}-{{ ml.code }}</p>{% endif %}
                                {% if type.name == 'Colour' %}
                                    <div class="available-in">
                                        {% for type in mildliners.types %}
                                            {% if type != 'Colour' %}
                                                {% if type in mildliners.colourData[ml.name] %}
                                                    <svg class="icon"><use xlink:href="#circle-{{ type | lower }}"></use></svg>
                                                {% endif %}
                                            {% endif %}
                                        {% endfor %}
                                        {% if ml.name in mildliners.mixColors %}
                                            <svg class="icon"><use xlink:href="#circle-mix"></use></svg>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endfor %}

         <div id="by-mix">
            
            <div class="mildliner-svg">
                <svg class="icon" style=""><use xlink:href="#pen-mix"></use></svg>
            </div>

            {% set setKeys = mildliners.mix | objectKeys %}

            <p style="margin: 0;"><strong>Mix has {{ mildliners.mix | length }} sets, 11 colour combinations, and 16 colours</strong></p>

            {% for set in setKeys %}
                <div class="mildliner-set">
                    
                    <h1 class="marker" style="margin-top: 0.5em;">{{ set }}</h1>

                    <p class="color-peek">
                        <a href="https://colorpeek.com#{% for h in mildliners.mix[set] %}{{ comma() }}{{ h[0].color }},{{ h[1].color }}{% endfor %}" target="_blank">
                        <svg class="icon" style="">
                            <use xlink:href="#colorpeek"></use>
                        </svg> view on colorpeek</a>
                    </p>
                    
                    {% for mix in mildliners.mix[set] %}
                        <div class="mildliner">
                            <div class="mildliner-bg">
                                <svg class="icon" style="width: 100%;height:100%;color: #{{ mix[0].color }}">
                                    <use xlink:href="#stroke"></use>
                                </svg>
                            </div>
                            <div class="mildliner-info">
                                <h2>{{ mix[0].name }}</h2>
                                <p class="mildliner-color" data-color="#{{ mix[0].color }}">#{{ mix[0].color }}</p>
                            </div>
                        </div>
                        <div class="mildliner" style="margin-top: -12px;">
                            <div class="mildliner-bg">
                                <svg class="icon" style="width: 100%;height:100%;color: #{{ mix[1].color }}">
                                    <use xlink:href="#stroke"></use>
                                </svg>
                            </div>
                            <div class="mildliner-info">
                                <h2>{{ mix[1].name }}</h2>
                                <p class="mildliner-color" data-color="#{{ mix[1].color }}">#{{ mix[1].color }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>

    <svg width="0" height="0" class="hidden">
        <svg viewBox="0 0 1183 90" xmlns="http://www.w3.org/2000/svg" id="stroke" preserveAspectRatio="none">
